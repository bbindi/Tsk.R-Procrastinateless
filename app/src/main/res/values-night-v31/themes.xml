<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark base theme for the app on Android 12+ -->
    <style name="Theme.TskR" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_900</item>
    </style>

    <!-- Splash screen theme with dynamic Material You dark background on Android 12+ -->
    <style name="Theme.TskR.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TskR</item>
    </style>
</resources>
